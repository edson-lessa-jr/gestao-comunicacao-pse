{
  "name": "gestao-comunicacao-pse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "wrangler d1 migrations apply gestao-comunicacao-pse --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint . --ignore-pattern .open-next --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gestao-comunicacao-pse --local",
    "db:migrate:remote": "wrangler d1 migrations apply gestao-comunicacao-pse --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Gest\u00e3o de Comunicados PSE"
}
