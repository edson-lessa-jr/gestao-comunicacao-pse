{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestao-comunicacao-pse",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestao-comunicacao-pse",
      "database_id": "298d9eb0-40d7-4ae5-bab8-fd7953a94dbc",
      "migrations_dir": "drizzle"
    }
  ],
  "secrets": {
    "required": [
      "PSE_ADMIN_USER",
      "PSE_ADMIN_PASSWORD",
      "PSE_SESSION_SECRET"
    ]
  },
  "observability": {
    "enabled": true
  }
}
